# Porta do servidor (padrão: 3000)
PORT=3000
NODE_ENV=production

# Chave secreta para criptografia de tokens e assinatura de sessões (mínimo 32 caracteres)
APP_SECRET="sua-chave-secreta-aleatoria-32-caracteres"

# URL de conexão com PostgreSQL (para self-hosting com docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatwoot_campaigns"

# Chave da API OpenAI para geração de variações (opcional, pode ser configurada via UI)
OPENAI_API_KEY=""

# GEMINI_API_KEY: Injetada automaticamente pelo Google AI Studio para fallback de IA
GEMINI_API_KEY=""

# APP_URL: URL base da aplicação
APP_URL="http://localhost:3000"
